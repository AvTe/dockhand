# --- Supabase (already provisioned — safe to use as-is) ---
# The URL and anon key are frontend-safe by design, fine to commit as an
# example. The SERVICE ROLE key is NOT: grab it yourself from
# Supabase dashboard -> Project Settings -> API, and put it only in your
# local .env.local (never commit it, never paste it in chat).
NEXT_PUBLIC_SUPABASE_URL=https://bculzrjiuzaroyoyrecf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJjdWx6cmppdXphcm95b3lyZWNmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwNzYxNTksImV4cCI6MjEwMzY1MjE1OX0.yFhEGL0C-T4_K1-74OUWyqeZxgH29OHWwHMswii4MB0
SUPABASE_SERVICE_ROLE_KEY=get-this-from-your-supabase-dashboard

# --- Shopify app "Dockhand" (already created and linked) ---
# shopify.app.toml is the source of truth for the client_id, the access
# scopes and the webhook subscriptions -- the Shopify CLI pushes that file
# to Shopify. Do NOT reintroduce a SHOPIFY_SCOPES var here: it would be a
# second name for [access_scopes].scopes and would drift from it.
#
# The client_id is public (it ships to the browser for App Bridge, and it's
# committed in shopify.app.toml), so it's prefilled here. It is NEXT_PUBLIC_
# because the app is embedded and App Bridge needs it client-side; Next.js
# also exposes NEXT_PUBLIC_ vars to server code, so this one name covers both.
NEXT_PUBLIC_SHOPIFY_API_KEY=0de0af659b1350f4eac27b0c0d5b97be

# The only genuine Shopify secret, and the only Shopify var any code reads
# today (src/lib/shopify/verifyWebhook.ts, for webhook HMAC verification).
# Get it from the app's page in the Shopify Partner dashboard.
SHOPIFY_API_SECRET=

# --- ClickUp OAuth app (you create this — see README) ---
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# --- Monday.com OAuth app (you create this — see README) ---
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=

# --- App ---
# The ONE public origin for this app. Used for both the Shopify app URL
# and as the base for every OAuth redirect URI (ClickUp + Monday
# callbacks are built from it). There is deliberately no separate
# SHOPIFY_APP_URL: two names for the same value is how you end up setting
# one of them on Vercel and getting a silently broken redirect.
# Must exactly match the redirect URIs registered in the ClickUp and
# Monday developer consoles.
#
# While running `shopify app dev`, the CLI creates an HTTPS tunnel and (because
# build.automatically_update_urls_on_dev = true) rewrites application_url and
# redirect_urls in shopify.app.toml to that tunnel URL. Set this to the same
# tunnel URL for that session, or the ClickUp/Monday OAuth redirects will still
# point at localhost while Shopify points at the tunnel.
APP_BASE_URL=http://localhost:3000
